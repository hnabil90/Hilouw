# Développement local uniquement. Copier dans .env puis remplacer les valeurs.
DATABASE_URL=postgresql://hilouw:CHANGE_ME@127.0.0.1:5433/hilouw
POSTGRES_USER=hilouw
POSTGRES_DB=hilouw
POSTGRES_PASSWORD=CHANGE_ME
PAYLOAD_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Facultatif : stockage S3 PRIVÉ. Sans bucket, fichiers locaux dans ./media.
# Ne pas activer de lecture publique sur le bucket ni de CDN qui contourne Payload.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
