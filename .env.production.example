# Copier dans .env sur le serveur. Remplacer chaque CHANGE_ME.
POSTGRES_USER=hilouw
POSTGRES_DB=hilouw
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_RANDOM_HEXADECIMAL_PASSWORD
PAYLOAD_SECRET=CHANGE_ME_WITH_ANOTHER_RANDOM_SECRET
NEXT_PUBLIC_SITE_URL=https://hilouw.com

# Facultatif. Sans S3, les fichiers utilisent le volume Docker media_data.
# Le bucket doit rester privé ; les téléchargements passent par Payload.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# true uniquement lorsque les contenus et textes juridiques sont prêts.
SITE_INDEXABLE=false
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
# true après configuration du header X-Hilouw-Client-IP dans Apache.
TRUST_PROXY=false
